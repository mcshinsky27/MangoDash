</div>
<script>
const qs = new URLSearchParams(location.search);
const deviceId = qs.get("device") || localStorage.getItem("mango-device");
const playlist = qs.get("playlist") || "";
const LETTERS = "ABCDEFGHJKLMNPQRSTUV".split("");   // authentic: no I, no O
const DIGITS = ["1","2","3","4","5","6","7","8","9","0"];
let tracks = [], selLetter = null, playingCard = null;
let provider = "spotify";   // "spotify" (server-side playback) or "youtube" (local CRT screen)
let lastSelectTime = 0;

const prog = document.getElementById("prog");
function setProg(t) { prog.textContent = t; }

// ---- Build: [rail][panel] x5 + blank right rail; 5x20 strips = 100 cards / 200 selections
const rack = document.getElementById("rack");
const cards = [];
for (let col = 0; col < 5; col++) {
  const rail = document.createElement("div"); rail.className = "rail";
  const panel = document.createElement("div"); panel.className = "panel";
  for (let row = 0; row < 20; row++) {
    const L = LETTERS[col * 4 + Math.floor(row / 5)];
    const r = row % 5;
    const n1 = String(2 * r + 1), n2 = (2 * r + 2) === 10 ? "0" : String(2 * r + 2);
    // brass tab cell: top tab = A-side code, bottom tab = B-side code
    const cell = document.createElement("div"); cell.className = "cell";
    cell.innerHTML = `<span>${L}${n1}</span><span>${L}${n2}</span>`;
    rail.appendChild(cell);
    // title strip: two clickable halves
    const strip = document.createElement("div");
    strip.className = "strip empty" + ((row + col) % 3 === 2 ? " pinstripe" : "");
    strip.innerHTML = `
      <div class="half a"><div class="ttl">&mdash;</div><div class="art"></div></div>
      <div class="half b"><div class="ttl">&mdash;</div><div class="art"></div></div>`;
    panel.appendChild(strip);
