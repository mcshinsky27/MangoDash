  50% { box-shadow: 0 4px 0 #3d3a30, 0 0 20px rgba(255,215,0,0.6),
    inset 0 2px 2px rgba(255,255,255,0.9), inset 0 -3px 4px rgba(184,134,11,0.8); }
}

