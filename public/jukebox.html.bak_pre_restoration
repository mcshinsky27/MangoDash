    linear-gradient(90deg, #8a6d2a 0%, #d9b95c 7%, #f6f1e0 14%, #fbf7ea 50%,
      #f2ecd8 86%, #cfa947 93%, #6d5316 100%),
    linear-gradient(180deg, #fffdf6, #ddd6c2);
  border-radius: 3px;
  box-shadow: 0 4px 0 #3d3a30, 0 6px 10px rgba(0,0,0,.7),
    inset 0 2px 2px rgba(255,255,255,.8), inset 0 -3px 4px rgba(90,70,20,.45); }
.key:active, .key.lit { transform: translateY(4px);
  box-shadow: 0 0 0 #3d3a30, 0 1px 4px rgba(0,0,0,.7),
    inset 0 2px 6px rgba(120,80,10,.5); background:
    linear-gradient(90deg, #8a6d2a 0%, #e0b545 7%, #ffe9a8 14%, #fff3c8 50%,
      #ffe9a8 86%, #d9a838 93%, #6d5316 100%); }
.gapper { width: clamp(6px, 1cqw, 18px); }
.key.reset { width: clamp(16px, 2.2cqw, 32px); font-size: clamp(5px, 0.6cqw, 9px);
  letter-spacing: 1px; font-family: "Courier New", monospace; }
.key.freeplay { 
  width: clamp(24px, 3.5cqw, 50px); 
  font-size: clamp(5px, 0.8cqw, 10px); 
  background: linear-gradient(90deg, #b8860b 0%, #ffd700 50%, #b8860b 100%);
  animation: freeplayPulse 2s ease-in-out infinite;
}
.key.freeplay:hover {
  filter: brightness(1.2);
  transform: translateY(-2px);
  box-shadow: 0 6px 0 #3d3a30, 0 8px 15px rgba(255,215,0,0.4),
