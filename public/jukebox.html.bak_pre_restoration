<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wurlitzer Zodiac</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden;
  background: #07090d; font-family: "Courier New", Courier, monospace; }
.juke { width: 100%; height: 100%; display: flex; flex-direction: column;
  background: linear-gradient(180deg, #14273a 0%, #0d1c2b 55%, #06101a 100%); }

/* ============ Marquee ============ */
.marquee { display: flex; align-items: center; justify-content: space-between;
  padding: 7px 20px;
  background: repeating-linear-gradient(90deg, #1d4a5a 0 3px, #16394a 3px 6px);
  border-bottom: 3px solid #e8ecf0; box-shadow: inset 0 -8px 16px rgba(0,0,0,.55); }
.mfm { background: #120d08; border: 3px solid #cfd6dd; border-radius: 8px;
  padding: 4px 18px; color: #ff9d2e; letter-spacing: 4px; font-weight: bold;
  font-size: clamp(9px, 1.4vw, 16px); text-shadow: 0 0 12px #ff9d2e; }
.progwin { background: #0c1006; border: 3px solid #cfd6dd; border-radius: 6px;
  padding: 4px 16px; color: #9fe870; font-size: clamp(9px, 1.3vw, 15px);
  letter-spacing: 3px; min-width: 200px; text-align: center;
  text-shadow: 0 0 8px #9fe870; }

/* ============ The glass ============ */
.rackwrap { flex: 1; min-height: 0; perspective: 1000px; padding: 8px 10px 0;
  position: relative; }
.rack { width: 100%; height: 100%;
  transform: rotateX(0deg) scale(1); transform-origin: 50% 100%;
  transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  display: flex; position: relative; overflow: hidden;
  border: 5px solid; border-color: #6f767e #9aa2ab #c8ced5 #9aa2ab; border-radius: 4px;
  background:
    radial-gradient(ellipse 22% 60% at 12% 45%, rgba(255,244,214,.95), transparent 70%),
    radial-gradient(ellipse 22% 60% at 31% 45%, rgba(255,244,214,.95), transparent 70%),
    radial-gradient(ellipse 22% 60% at 50% 45%, rgba(255,244,214,.95), transparent 70%),
    radial-gradient(ellipse 22% 60% at 69% 45%, rgba(255,244,214,.95), transparent 70%),
    radial-gradient(ellipse 22% 60% at 88% 45%, rgba(255,244,214,.95), transparent 70%),
    linear-gradient(180deg, #b8ab8c, #e5dab5 25%, #efe6c2 60%, #b8ab8c);
  box-shadow: inset 0 0 80px rgba(255,205,110,.5), inset 0 0 18px rgba(0,0,0,.35),
    0 -8px 28px rgba(0,0,0,.65); }
.rack.slanted { transform: rotateX(28deg) scale(1.02); }
/* glass glare + vignette */
.rack::after { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 6;
  background:
    linear-gradient(112deg, transparent 26%, rgba(255,255,255,.30) 36%, rgba(255,255,255,.06) 43%,
      transparent 49%, transparent 66%, rgba(255,255,255,.16) 73%, transparent 80%),
    radial-gradient(ellipse 140% 120% at 50% 40%, transparent 62%, rgba(20,14,4,.38) 100%); }

/* Brass rails with selection tabs */
.rail { width: clamp(20px, 2.6vw, 34px); flex: 0 0 auto; display: flex; flex-direction: column;
  background: linear-gradient(90deg, #6d5316, #c49a3a 18%, #f2e09a 50%, #c49a3a 82%, #5c450f);
  box-shadow: 2px 0 4px rgba(0,0,0,.35), -2px 0 4px rgba(0,0,0,.35); z-index: 2; }
.rail .cell { flex: 1; min-height: 0; display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 1px; padding: 1px 2px;
  border-bottom: 1px solid rgba(70,50,5,.45); }
.rail .cell span { flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: clamp(4px, .62vw, 9px); font-weight: bold; color: #211703;
  background: linear-gradient(180deg, #f7ecc0, #d9bd6b);
  border: 1px solid rgba(90,65,10,.5); border-radius: 1px; line-height: 1; }
.rail.blank .cell span { visibility: hidden; }

/* Title strip panels */
.panel { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 2px 3px; }
.strip { flex: 1; min-height: 0; margin: 1px 0; position: relative; overflow: hidden;
  display: flex; flex-direction: column; border-radius: 2px/5px;
  background: linear-gradient(180deg, #cdc2ad 0%, #f6efdd 16%, #fffdf4 42%,
    #fbf5e4 58%, #e8dfc8 84%, #b9ad94 100%);   /* bowed card catching the light */
  box-shadow: inset 0 5px 7px -5px rgba(60,40,10,.55),
    inset 0 -6px 8px -5px rgba(60,40,10,.6), 0 1px 2px rgba(0,0,0,.35); }
.strip::before, .strip::after {   /* "All Time Hits" style red rosettes on the ends */
  content: ""; position: absolute; top: 50%; width: 7%; max-width: 14px;
  aspect-ratio: 1; transform: translateY(-50%); border-radius: 50%; opacity: .5;
  background: radial-gradient(circle, #b02020 30%, transparent 32%,
    transparent 45%, #b02020 47%, #b02020 55%, transparent 57%); }
.strip::before { left: 1.5%; } .strip::after { right: 1.5%; }
.half { flex: 1; min-height: 0; display: flex; flex-direction: column;
  justify-content: center; cursor: pointer; padding: 0 9%; }
.half.a { border-bottom: 1px dotted rgba(150,60,60,.55); }
.half:hover { background: rgba(255,240,180,.5); }
.ttl { text-align: center; font-weight: bold; color: #241a10;
  font-size: clamp(4.5px, .74vw, 10.5px); letter-spacing: .5px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.25; }
.art { text-align: center; color: #5a4a35; font-size: clamp(4px, .6vw, 8.5px);
  letter-spacing: .8px; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis; line-height: 1.2; }
.strip.pinstripe .ttl { color: #402028; }
.strip.pinstripe { background: linear-gradient(180deg, #cdb9ad 0%, #f8ecdf 16%,
  #fff6ef 42%, #fbeee4 58%, #e8d5c8 84%, #b99e94 100%); }
.strip.empty { opacity: .35; } .strip.empty .half { cursor: default; }
.strip.playing { box-shadow: inset 0 0 14px rgba(255,150,40,.85), 0 0 8px rgba(255,170,60,.6); }

/* Center mechanism window */
.mech { position: absolute; left: 50%; top: 34%; transform: translateX(-50%);
  z-index: 5; text-align: center; pointer-events: none; }
.mech .win { margin: 4px auto 0; width: clamp(30px, 4vw, 56px); aspect-ratio: 1/1.25;
  background: radial-gradient(circle at 50% 42%, #2a2118 20%, #0d0a06 75%);
  border: 3px solid #8a8f96; border-radius: 4px; overflow: hidden;
  display: none; align-items: center; justify-content: center;
  box-shadow: inset 0 0 10px #000; }
.mech .disc { width: 78%; aspect-ratio: 1; border-radius: 50%;
  background: radial-gradient(circle, #c8842a 0 18%, #111 19% 45%, #1d1d1d 46% 52%,
    #111 53% 78%, #2a2a2a 79% 100%); opacity: 0; }
.mech.on .disc { opacity: 1; animation: spin45 1.35s linear infinite; }
@keyframes spin45 { to { transform: rotate(360deg); } }

/* ============ Keypad (photo 3) ============ */
.keys { padding: 0 14px 10px; background: linear-gradient(180deg, #0b0e13, #04060a); }
.chrome { height: clamp(7px, 1vh, 12px); border-radius: 3px; margin: 0 -14px;
  background: linear-gradient(180deg, #f8fafc 0%, #c9cfd6 22%, #8f979f 46%,
    #d8b49a 58%, #6b7079 74%, #3a3f46 100%); box-shadow: 0 2px 6px rgba(0,0,0,.6); }
.kpanel { margin: 8px 0; padding: clamp(6px, 1.2vh, 14px) 14px;
  background: #0b0d11; border-radius: 4px;
  box-shadow: inset 0 0 0 2px #0b0d11, inset 0 0 0 3px #d8dde2,
    inset 0 0 0 6px #0b0d11, inset 0 0 0 7px #9aa2ab, inset 0 3px 14px rgba(0,0,0,.9);
  container-type: inline-size; }
.keyrow { display: flex; gap: clamp(2px, 0.4cqw, 5px); justify-content: space-between;
