function trackFor(col, row, side) { return tracks[(row * 5 + col) * 2 + side] || null; }
const Q = s => "\u201C" + s + "\u201D";

async function loadTracks() {
  // Use public endpoint if no device paired, otherwise use paired endpoint
  const endpoint = deviceId 
    ? `/api/display/${deviceId}/jukebox?playlist=${encodeURIComponent(playlist)}`
    : `/api/jukebox?playlist=${encodeURIComponent(playlist)}`;
  
  console.log("Loading tracks from:", endpoint);
  const d = await (await fetch(endpoint)).json();
  console.log("Track data received:", d);
  if (d.error) { setProg(d.error.toUpperCase().slice(0, 40)); return; }
  
  // Household Spotify account not connected -> show a "Log in to Spotify"
  // button (same flow as the dashboard Spotify widgets), then retry once the
  // connection succeeds so the jukebox fills without a page reload.
  if (d.connected === false && d.loginUrl) {
    let ov = document.querySelector(".sp-auth-overlay");
    if (!ov) {
      ov = document.createElement("div");
      ov.className = "sp-auth-overlay";
      ov.innerHTML = `<div class="sp-auth-card">
        <div class="sp-auth-icon">&#127925;</div>
        <div class="sp-auth-title">SPOTIFY NOT CONNECTED</div>
        <div class="sp-auth-text">Connect a Spotify account so the jukebox can load and play full tracks.</div>
        <button type="button" class="sp-auth-btn">LOG IN TO SPOTIFY</button></div>`;
      ov.querySelector(".sp-auth-btn").onclick = () => {
        window.open(d.loginUrl, "spotifyAuth", "width=560,height=780");
      };
      document.body.appendChild(ov);
      const retry = setInterval(async () => {
        try {
          const st = await (await fetch(`/api/display/${deviceId}/spotify/status`)).json();
          if (st.connected) {
            clearInterval(retry);
            ov.remove();
            loadTracks();
          }
        } catch (e) { /* keep polling */ }
      }, 5000);
    }
    return;
  }
  const oldOv = document.querySelector(".sp-auth-overlay");
  if (oldOv) oldOv.remove();
  provider = d.provider || "spotify";
  tracks = d.tracks || [];
  cards.forEach(c => {
    const a = trackFor(c.col, c.row, 0), b = trackFor(c.col, c.row, 1);
    const ha = c.el.querySelector(".half.a"), hb = c.el.querySelector(".half.b");
    ha.querySelector(".ttl").textContent = a ? Q(a.name.toUpperCase()) : "\u2014";
    ha.querySelector(".art").textContent = a ? a.artist.toUpperCase() : "";
    hb.querySelector(".ttl").textContent = b ? Q(b.name.toUpperCase()) : "\u2014";
    hb.querySelector(".art").textContent = b ? b.artist.toUpperCase() : "";
    c.el.classList.toggle("empty", !a && !b);
    ha.onclick = a ? () => select(c.sel[0][0], c.sel[0].slice(1)) : null;
    hb.onclick = b ? () => select(c.sel[1][0], c.sel[1].slice(1)) : null;
  });
  setProg("MAKE SELECTION");
}

