// ---- Selection -> mechanical sequence -> Spotify/YouTube ----
function select(L, D) {
  const Li = LETTERS.indexOf(L); if (Li < 0) return;
  const dnum = D === "0" ? 10 : +D;
  const col = Math.floor(Li / 4), rowBlock = Li % 4;
  const r = Math.floor((dnum - 1) / 2), side = (dnum % 2 === 1) ? 0 : 1;
  const row = rowBlock * 5 + r;
  const track = trackFor(col, row, side);
  if (!track) { setProg(L + D + "  \u2014 EMPTY SLOT"); return; }
  
  // Unpaired device with Spotify tracks - not allowed
  if (!deviceId && provider === "spotify") {
    setProg("SPOTIFY REQUIRES PAIRED DEVICE");
    return;
  }
  
  setProg("SELECTION  " + L + " " + D);
  const card = cards.find(c => c.col === col && c.row === row);
  if (playingCard) playingCard.el.classList.remove("playing");
  playingCard = card; card.el.classList.add("playing");
  document.getElementById("rack").classList.add("slanted");
  document.getElementById("mech").classList.remove("on");
  lastSelectTime = Date.now();
  
  // Skip mechanical sound sequence - start playback immediately
  // mechanicalSequence(async () => {
  setTimeout(async () => {
    if (provider === "youtube") {
      // YouTube tracks play locally on the CRT screen (server has no playback role).
      startYt(track);
      document.getElementById("mech").classList.add("on");
      setProg("NOW PLAYING  " + L + " " + D);
    } else {
      await fetch(`/api/display/${deviceId}/jukebox/play`, { method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ uri: track.uri, player: qs.get("player") || "" }) });
      document.getElementById("mech").classList.add("on");
      setProg("NOW PLAYING  " + L + " " + D);
    }
  }, 100);
  // });
  selLetter = null; lightLetter(null);
}

// ---- YouTube mode: CRT screen + IFrame player ----
let ytPlayer = null, ytReady = false, ytPending = null;
// The jukebox runs inside a dashboard iframe; tell the parent when YouTube
// playback starts/stops so page rotation holds during a song.
function notifyPlaying(playing) {
  try { parent.postMessage({ type: "jukebox-playing", playing: !!playing }, "*"); } catch (e) { /* no parent */ }
}
window.onYouTubeIframeAPIReady = () => { ytReady = true; };
(function loadYTApi() {
  const s = document.createElement("script");
  s.src = "https://www.youtube.com/iframe_api";
  document.head.appendChild(s);
})();
function ensureYtPlayer() {
  if (ytPlayer) return ytPlayer;
  try {
    ytPlayer = new YT.Player("yt-player", {
      width: "100%", height: "100%",
      playerVars: { 
        autoplay: 0, 
        controls: 1,              // Enable controls so user can select quality
        modestbranding: 1, 
        rel: 0, 
        playsinline: 1,
        quality: "hd1080",        // Request highest quality
        hd: 1                     // Force HD mode
      },
      events: {
        onReady: (e) => {
          ytReady = true;
          // The 4.1s mechanical delay means the original click gesture is stale,
          // so autoplay may be refused by the browser; tapping the screen starts it.
          if (ytPending) { 
            e.target.loadVideoById(ytPending);
            // Hint at highest quality after load
            setTimeout(() => {
              if (e.target.setPlaybackQualityRange) {
                e.target.setPlaybackQualityRange(1080, 2160);
              }
            }, 500);
            ytPending = null; 
          }
        },
        onStateChange: e => {
          if (e.data === YT.PlayerState.ENDED) stopYt();
          // Report play state to the parent dashboard so page rotation holds.
          notifyPlaying(e.data === YT.PlayerState.PLAYING);
        }
      }
    });
  } catch (e) { console.error("YouTube player init failed:", e); }
  return ytPlayer;
}
function startYt(track) {
  document.getElementById("classic-win").style.display = "none";
  document.getElementById("video-screen").style.display = "block";
  document.getElementById("screen-song-title").textContent =
    (track.name + " \u2013 " + track.artist).toUpperCase().slice(0, 48);
  const p = ensureYtPlayer();
  if (!p) return;
  if (ytReady && p.loadVideoById) p.loadVideoById(track.uri);
  else ytPending = track.uri;
}
function stopYt() {
  notifyPlaying(false);
  if (ytPlayer && ytPlayer.stopVideo) { try { ytPlayer.stopVideo(); } catch (e) { /* player gone */ } }
  document.getElementById("video-screen").style.display = "none";
  document.getElementById("classic-win").style.display = "";
  document.getElementById("mech").classList.remove("on");
  document.getElementById("rack").classList.remove("slanted");
  if (playingCard) {
    playingCard.el.classList.remove("playing");
    playingCard = null;
  }
  setProg("MAKE SELECTION");
}
document.getElementById("screen-close-btn").onclick = () => { clickSound(); stopYt(); };

// ---- WebAudio: synthesized 45-loading sounds ----
let AC = null;
function ac() { if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)(); return AC; }
function noiseBuf(secs) {
  const c = ac(), b = c.createBuffer(1, c.sampleRate * secs, c.sampleRate);
  const d = b.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
  return b;
}
function clickSound() {
  const c = ac(), s = c.createBufferSource(); s.buffer = noiseBuf(.06);
  const f = c.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = 900;
  const g = c.createGain(); g.gain.setValueAtTime(.5, c.currentTime);
  g.gain.exponentialRampToValueAtTime(.01, c.currentTime + .06);
  s.connect(f).connect(g).connect(c.destination); s.start();
}
function motorWhir(t0, dur) {
  const c = ac(), s = c.createBufferSource(); s.buffer = noiseBuf(dur);
  const f = c.createBiquadFilter(); f.type = "bandpass"; f.Q.value = 3;
  f.frequency.setValueAtTime(180, t0); f.frequency.linearRampToValueAtTime(320, t0 + dur * .5);
  f.frequency.linearRampToValueAtTime(200, t0 + dur);
  const g = c.createGain(); g.gain.setValueAtTime(0, t0);
  g.gain.linearRampToValueAtTime(.12, t0 + .2);
  g.gain.setValueAtTime(.12, t0 + dur - .3); g.gain.linearRampToValueAtTime(0, t0 + dur);
  s.connect(f).connect(g).connect(c.destination); s.start(t0); s.stop(t0 + dur);
}
function metalClunk(t0, pitch, vol) {
  const c = ac(), o = c.createOscillator(); o.type = "sine"; o.frequency.value = pitch;
  const g = c.createGain(); g.gain.setValueAtTime(vol, t0);
  g.gain.exponentialRampToValueAtTime(.001, t0 + .18);
  o.connect(g).connect(c.destination); o.start(t0); o.stop(t0 + .2);
}
function transferThunk(t0) {
  const c = ac(), s = c.createBufferSource(); s.buffer = noiseBuf(.15);
  const f = c.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = 400;
  const g = c.createGain(); g.gain.setValueAtTime(.35, t0);
  g.gain.exponentialRampToValueAtTime(.001, t0 + .15);
  s.connect(f).connect(g).connect(c.destination); s.start(t0); s.stop(t0 + .15);
}
function recordDrop(t0) {
  const c = ac(), s = c.createBufferSource(); s.buffer = noiseBuf(.25);
  const f = c.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = 600;
  const g = c.createGain(); g.gain.setValueAtTime(.4, t0);
  g.gain.exponentialRampToValueAtTime(.001, t0 + .25);
  s.connect(f).connect(g).connect(c.destination); s.start(t0); s.stop(t0 + .25);
}
function needleDrop(t0) {
  const c = ac(), s = c.createBufferSource(); s.buffer = noiseBuf(.35);
  const f = c.createBiquadFilter(); f.type = "bandpass"; f.frequency.value = 1200; f.Q.value = 1.5;
  const g = c.createGain(); g.gain.setValueAtTime(.25, t0);
  g.gain.exponentialRampToValueAtTime(.001, t0 + .35);
  s.connect(f).connect(g).connect(c.destination); s.start(t0); s.stop(t0 + .35);
}
function vinylCrackle(t0, dur) {
  const c = ac(), s = c.createBufferSource(); s.buffer = noiseBuf(dur);
  const f = c.createBiquadFilter(); f.type = "highpass"; f.frequency.value = 800;
  const g = c.createGain(); g.gain.setValueAtTime(.08, t0);
  g.gain.linearRampToValueAtTime(.06, t0 + dur * .6);
  g.gain.linearRampToValueAtTime(.02, t0 + dur);
  s.connect(f).connect(g).connect(c.destination); s.start(t0); s.stop(t0 + dur);
}
function mechanicalSequence(done) {
  const c = ac(), t = c.currentTime;
  motorWhir(t + .1, 2.2);                   // carriage travels to the record
  metalClunk(t + 1.8, 120, .35);            // carriage arrives, transfer arm engages
  transferThunk(t + 2.1);                   // arm grabs the 45
  metalClunk(t + 2.4, 90, .3);              // arm moves record toward platter
  recordDrop(t + 2.8);                      // 45 drops onto the platter
  metalClunk(t + 3.1, 180, .25);            // record settles
  needleDrop(t + 3.4);                      // needle descends onto vinyl
  vinylCrackle(t + 3.5, 1.2);               // vinyl crackle as music begins
  setProg("LOADING RECORD ...");
  setTimeout(done, 4600);                   // music starts as the crackle fades
}

// ---- Free Play Mode ----
let freePlayActive = false;
let freePlayQueue = [];
let freePlayTimer = null;
const FREEPLAY_GAP_MS = 15000; // 15 seconds between songs

function toggleFreePlay() {
  if (freePlayActive) {
    stopFreePlay();
  } else {
    startFreePlay();
  }
}

function startFreePlay() {
  if (tracks.length === 0) {
    setProg("NO TRACKS AVAILABLE");
    return;
  }
  
  // Shuffle all tracks into queue
  freePlayQueue = [...tracks].sort(() => Math.random() - 0.5);
  freePlayActive = true;
  freePlayBtn.classList.add("active");
  freePlayBtn.textContent = "STOP";
  
  // Play first song immediately
  playNextFreePlayTrack();
}

function stopFreePlay() {
  freePlayActive = false;
  freePlayQueue = [];
  if (freePlayTimer) {
    clearTimeout(freePlayTimer);
    freePlayTimer = null;
  }
  freePlayBtn.classList.remove("active");
  freePlayBtn.textContent = "FREE PLAY";
  setProg("MAKE SELECTION");
}

function playNextFreePlayTrack() {
  if (!freePlayActive || freePlayQueue.length === 0) {
    if (freePlayActive) {
      setProg("FREE PLAY • QUEUE EMPTY");
    }
    return;
  }
  
  // Take next random track from queue
  const trackIndex = Math.floor(Math.random() * freePlayQueue.length);
  const track = freePlayQueue.splice(trackIndex, 1)[0];
  
  // Find the card for this track
  const card = cards.find(c => {
    const a = trackFor(c.col, c.row, 0), b = trackFor(c.col, c.row, 1);
    return (a && a.uri === track.uri) || (b && b.uri === track.uri);
  });
  
  if (card) {
    const side = card.el.querySelector(".half.a").textContent.includes(track.name) ? "a" : "b";
    select(card.sel[side === "a" ? 0 : 1][0], card.sel[side === "a" ? 1 : 0]);
  }
  
  // Schedule next song
  freePlayTimer = setTimeout(() => {
    if (freePlayActive) {
      playNextFreePlayTrack();
    }
  }, FREEPLAY_GAP_MS);
}

// ---- Coin Slot & Payment ----
function handleCoinClick() {
  // Play coin drop sound
  const c = ac();
  const coinSound = c.createBufferSource();
  coinSound.buffer = noiseBuf(.15);
  const coinFilter = c.createBiquadFilter();
  coinFilter.type = "lowpass";
  coinFilter.frequency.value = 1200;
  const coinGain = c.createGain();
  coinGain.gain.setValueAtTime(.4, c.currentTime);
  coinGain.gain.exponentialRampToValueAtTime(.01, c.currentTime + .15);
  coinSound.connect(coinFilter).connect(coinGain).connect(c.destination);
  coinSound.start();
  
  // Show coin drop animation
  const overlay = document.createElement("div");
  overlay.className = "coin-drop-overlay active";
  overlay.innerHTML = '<div class="coin"></div>';
  document.body.appendChild(overlay);
  
  setTimeout(() => {
    overlay.remove();
    showPaymentModal();
  }, 500);
}

function showPaymentModal() {
  // Play celebratory chime (major chord)
  const c = ac();
  const freqs = [523, 659, 784]; // C-E-G
  freqs.forEach((f, i) => {
    setTimeout(() => {
      const osc = c.createOscillator();
      osc.type = "sine";
      osc.frequency.value = f;
      const gain = c.createGain();
      gain.gain.setValueAtTime(.2, c.currentTime);
      gain.gain.exponentialRampToValueAtTime(.01, c.currentTime + 1.5);
      osc.connect(gain).connect(c.destination);
      osc.start();
      osc.stop(c.currentTime + 1.5);
    }, i * 50);
  });
  
  // Show modal
  const modal = document.createElement("div");
  modal.className = "payment-modal";
  modal.innerHTML = `
    <button class="payment-close">&times;</button>
    <div class="payment-content">
      <div class="payment-header">🪙 THANK YOU! 🪙</div>
      <div class="payment-amount">ONE QUARTER</div>
      <div class="payment-message">For this fine musical entertainment</div>
      <button class="venmo-btn" id="venmoBtn">VENMO</button>
      <div class="venmo-handle">@RobMc27</div>
    </div>`;
  document.body.appendChild(modal);
  
  // Event handlers
  modal.querySelector("#venmoBtn").onclick = () => {
    window.open("https://venmo.com/RobMc27", "_blank");
    modal.remove();
  };
  
  modal.querySelector(".payment-close").onclick = () => {
    modal.remove();
  };
  
  modal.onclick = (e) => {
    if (e.target === modal) modal.remove();
  };
  
  document.addEventListener("keydown", function escHandler(e) {
    if (e.key === "Escape") {
      modal.remove();
      document.removeEventListener("keydown", escHandler);
    }
  });
}

let spotifyPollInterval = null;
function startSpotifyPolling() {
  if (spotifyPollInterval) clearInterval(spotifyPollInterval);
  const poll = async () => {
    if (provider !== "spotify" || !deviceId) return;
    if (Date.now() - lastSelectTime < 10000) return;
    try {
      const res = await fetch(`/api/display/${deviceId}/spotify`);
      if (res.ok) {
        const d = await res.json();
        if (d.connected && d.playing) {
          document.getElementById("rack").classList.add("slanted");
          document.getElementById("mech").classList.add("on");
          if (d.track) {
            setProg("NOW PLAYING  " + d.track.toUpperCase().slice(0, 30));
          }
        } else {
          document.getElementById("rack").classList.remove("slanted");
          document.getElementById("mech").classList.remove("on");
          if (playingCard) {
            playingCard.el.classList.remove("playing");
            playingCard = null;
          }
          if (prog.textContent.startsWith("NOW PLAYING")) {
            setProg("MAKE SELECTION");
          }
        }
      }
    } catch (e) {
      console.error("Spotify poll failed:", e);
    }
  };
  poll();
  spotifyPollInterval = setInterval(poll, 4000);
}

// Load tracks for both paired and unpaired devices
loadTracks();
setInterval(loadTracks, 10 * 60e3);

// Spotify polling only for paired devices
if (deviceId) startSpotifyPolling();
